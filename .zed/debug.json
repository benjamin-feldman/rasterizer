[
  {
    "label": "Debug rasterizer",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/rasterizer",
    "cwd": "$ZED_WORKTREE_ROOT",
    "build": {
      "command": "clang++",
      "args": [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-g",
        "main.cpp",
        "-o",
        "rasterizer"
      ]
    }
  }
]
